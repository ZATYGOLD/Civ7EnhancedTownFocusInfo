<?xml version="1.0" encoding="utf-8"?>
<Mod id="EnhancedTownFocusInfoMod" version="20503" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MOD_ENHANCEDTOWNFOCUSINFO</Name>
		<Description>LOC_MOD_ENHANCEDTOWNFOCUSINFO_DESCRIPTION</Description>
		<Authors>Zatygold</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>0</AffectsSavedGames>
		<Version>2.5.3</Version>
		<LastUpdated>2026-10-11</LastUpdated>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<References>
		<Mod id="core" title="LOC_MODULE_CORE_NAME"/>
	</References>
	<ActionCriteria>
		<Criteria id="always"><AlwaysMet/></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- LoadOrder 1100 puts this after base-standard's own post-process pass
		     (999), so the Town Focus panel exists before the mod patches it. -->
		<ActionGroup id="etfi-shell" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>1100</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>text/en_us/InGameText.xml</Item>
					<Item locale="fr_FR">text/fr_FR/InGameText.xml</Item>
					<Item locale="it_IT">text/it_IT/InGameText.xml</Item>
					<Item locale="ja_JP">text/ja_JP/InGameText.xml</Item>
					<Item locale="ko_KR">text/ko_KR/InGameText.xml</Item>
					<Item locale="pl_PL">text/pl_PL/InGameText.xml</Item>
					<Item locale="ru_RU">text/ru_RU/InGameText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_Hans_CN/InGameText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_Hant_HK/InGameText.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>vendor/settings.js</Item>
					<Item>ui/settings-init.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
		<ActionGroup id="etfi-game" scope="game" criteria="always">
			<Properties><LoadOrder>1100</LoadOrder></Properties>
			<Actions>
				<ImportFiles>
					<Item>ui/production-chooser/town-focus-section-decorator.css</Item>
				</ImportFiles>
				<UIScripts>
					<Item>vendor/settings.js</Item>
					<Item>ui/settings-init.js</Item>
					<Item>ui/utilities/utilities-town-focus.js</Item>
					<Item>ui/town-focus/contributions.js</Item>
					<Item>ui/town-focus/farm-fish-towns.js</Item>
					<Item>ui/town-focus/mining-town.js</Item>
					<Item>ui/town-focus/trade-town.js</Item>
					<Item>ui/town-focus/hub-town.js</Item>
					<Item>ui/town-focus/temple-town.js</Item>
					<Item>ui/town-focus/urban-town.js</Item>
					<Item>ui/town-focus/fort-town.js</Item>
					<Item>ui/town-focus/resort-town.js</Item>
					<Item>ui/town-focus/factory-town.js</Item>
					<Item>ui/town-focus/focus-models.js</Item>
					<Item>ui/components/town-focus-rows.js</Item>
					<Item>ui/components/town-focus-view-state.js</Item>
					<Item>ui/components/etfi-tooltip-section-description.js</Item>
					<Item>ui/production-chooser/town-focus-tooltip.js</Item>
					<Item>ui/production-chooser/town-focus-section-decorator.js</Item>
				</UIScripts>
				<UpdateText>
					<Item>text/en_us/InGameText.xml</Item>
					<Item locale="fr_FR">text/fr_FR/InGameText.xml</Item>
					<Item locale="it_IT">text/it_IT/InGameText.xml</Item>
					<Item locale="ja_JP">text/ja_JP/InGameText.xml</Item>
					<Item locale="ko_KR">text/ko_KR/InGameText.xml</Item>
					<Item locale="pl_PL">text/pl_PL/InGameText.xml</Item>
					<Item locale="ru_RU">text/ru_RU/InGameText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_Hans_CN/InGameText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_Hant_HK/InGameText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModInfoText.xml</File>
		<File>text/fr_FR/ModInfoText.xml</File>
		<File>text/it_IT/ModInfoText.xml</File>
		<File>text/ja_JP/ModInfoText.xml</File>
		<File>text/ko_KR/ModInfoText.xml</File>
		<File>text/ru_RU/ModInfoText.xml</File>
		<File>text/pl_PL/ModInfoText.xml</File>
		<File>text/zh_Hans_CN/ModInfoText.xml</File>
		<File>text/zh_Hant_HK/ModInfoText.xml</File>
	</LocalizedText>
</Mod>
